{
  "hindsight_host": {
    "description": "Hindsight 服务地址",
    "hint": "记忆服务的地址，例如 localhost 或 192.168.1.10。",
    "type": "string",
    "default": "localhost"
  },
  "hindsight_port": {
    "description": "Hindsight 服务端口",
    "hint": "记忆服务的端口，默认 8888。",
    "type": "int",
    "slider": {
      "min": 1,
      "max": 65535,
      "step": 1
    },
    "default": 8888
  },
  "hindsight_token": {
    "description": "Hindsight 鉴权 Token（可选）",
    "hint": "服务端开启鉴权时填写；本地自建、未开启鉴权的服务请留空，插件不会发送鉴权头。令牌仅保存在本机配置文件中。",
    "type": "string",
    "secret": true,
    "obvious_hint": true,
    "default": ""
  },
  "sync_batch_chars": {
    "description": "单批提交字符上限",
    "hint": "按 id 顺序逐条累加正文长度，加入下一条会超过该值时就先提交已有内容；单条本身就超限时单独提交，避免队列被一条巨长消息堵死。默认 5000。",
    "type": "int",
    "slider": {
      "min": 500,
      "max": 50000,
      "step": 500
    },
    "default": 5000
  },
  "sync_daily_time": {
    "description": "每日补投时间",
    "hint": "格式为 HH:MM，按本机时区。每天在该时刻检查是否有未提交的记录并补投。默认 00:05。",
    "type": "string",
    "default": "00:05"
  },
  "recall_memory_quantity": {
    "description": "召回记忆数量",
    "hint": "每次对话前注入上下文的记忆事实条数，必须大于 0。默认 5。",
    "type": "int",
    "slider": {
      "min": 1,
      "max": 50,
      "step": 1
    },
    "default": 5
  }
}
